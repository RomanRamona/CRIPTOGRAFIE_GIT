<Window x:Class="HashCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crypto Hash Tool" Height="350" Width="500">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Selectați fișierul:" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,15">
                <Button Content="Browse" Click="Browse_Click" Width="75" DockPanel.Dock="Right"/>
                <TextBox x:Name="txtFilePath" IsReadOnly="True" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Algoritm Hash:" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbHashAlgorithm" Margin="0,0,0,20"/>

            <Button Content="Calculează Hash" Click="Calculate_Click" Height="40" Background="#007ACC" Foreground="White"/>

            <TextBlock Text="Rezultat (Hex):" Margin="0,15,0,5"/>
            <TextBox x:Name="txtResult" IsReadOnly="True" TextWrapping="Wrap" Height="60" Background="#F0F0F0"/>

            <ProgressBar x:Name="pbStatus" Height="10" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Hidden"/>
        </StackPanel>
    </Grid>
</Window>